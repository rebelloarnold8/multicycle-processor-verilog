@000 0230000100000400  // 0000: lw   r1, 0x400(r0)   # r1 = 25
@001 0230000200000408  // 0008: lw   r2, 0x408(r0)   # r2 = 17
@002 0000040200c00020  // 0010: add  r3, r1, r2      # r3 = 42
@003 0000040201000022  // 0018: sub  r4, r1, r2      # r4 = 8
@004 02b0000300000410  // 0020: sw   r3, 0x410(r0)   # mem[0x410] = 42
@005 0040040100000001  // 0028: beq  r1, r1, +1      # taken: skip next
@006 0000040101400020  // 0030: add  r5, r1, r1      # SKIPPED (r5 stays 0)
@007 0040040200000001  // 0038: beq  r1, r2, +1      # not taken
@008 00000c0401800020  // 0040: add  r6, r3, r4      # r6 = 50
@009 0230000700000410  // 0048: lw   r7, 0x410(r0)   # r7 = 42 (store->load)
@00a 00400000ffffffff  // 0050: beq  r0, r0, -1      # halt: branch to self
@080 0000000000000019  // 0400: data 25
@081 0000000000000011  // 0408: data 17
